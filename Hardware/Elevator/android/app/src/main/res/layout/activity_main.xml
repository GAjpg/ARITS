<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- 标题 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="18dp"
        android:text="@string/app_name"
        android:textColor="@color/text_primary"
        android:textSize="27sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="6dp"
        android:text="@string/subtitle"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <!--
      层显：两台电梯各一个（甲梯 / 乙梯），**一样大**。
      框里只放那一个大数字 —— 底下不写小字（连接状态在页面最下面那条里说）。
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_floor_display"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="8dp"
            android:paddingEnd="20dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/floorDisplay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:letterSpacing="0.06"
                android:text="@string/floor_none"
                android:textColor="@color/display_digit"
                android:textSize="56sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_floor_display"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="8dp"
            android:paddingEnd="20dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/floorDisplayB"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:letterSpacing="0.06"
                android:text="@string/floor_none"
                android:textColor="@color/display_digit"
                android:textSize="56sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- 两台电梯井道并排（甲梯 / 乙梯）+ 浮动提示 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <!-- 甲梯：跟着你走的那台（真机上 = 蓝牙判层 + 真读数） -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <com.hackathon.elevator.ElevatorView
                    android:id="@+id/elevatorView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="40dp"
                    android:background="@drawable/bg_pill"
                    android:paddingStart="11dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="11dp"
                    android:paddingBottom="4dp"
                    android:text="@string/mock_label_car_a"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
            </FrameLayout>

            <!-- 乙梯：另一台电梯（纯画面装饰，随机慢慢跑） -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <com.hackathon.elevator.ElevatorView
                    android:id="@+id/elevatorViewB"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="40dp"
                    android:background="@drawable/bg_pill"
                    android:paddingStart="11dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="11dp"
                    android:paddingBottom="4dp"
                    android:text="@string/mock_label_car_b"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
            </FrameLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/hintBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_hint"
            android:gravity="center"
            android:paddingStart="18dp"
            android:paddingTop="10dp"
            android:paddingEnd="18dp"
            android:paddingBottom="10dp"
            android:text="@string/hint_not_connected"
            android:textColor="@color/hint_text"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- 进「队友导航 App 效果模拟页」的入口（只是给我们自己人看效果用） -->
        <TextView
            android:id="@+id/btnMock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_pill"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="13dp"
            android:paddingTop="7dp"
            android:paddingEnd="13dp"
            android:paddingBottom="7dp"
            android:text="@string/mock_entry"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <!-- 进「摄像头读楼层」的入口（方案 D：读电梯厅屏上的数字） -->
        <TextView
            android:id="@+id/btnCamera"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_marginStart="10dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_pill"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="13dp"
            android:paddingTop="7dp"
            android:paddingEnd="13dp"
            android:paddingBottom="7dp"
            android:text="@string/cam_entry"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </FrameLayout>

    <!-- 楼层按钮 B / 1F / 2F / 3F（灰掉的是没有装置的层） -->
    <LinearLayout
        android:id="@+id/floorRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal" />

    <!-- 上行 / 下行 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUp"
            android:layout_width="78dp"
            android:layout_height="78dp"
            android:backgroundTint="@color/call_bg"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/arrow_up"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            app:cornerRadius="39dp" />

        <Space
            android:layout_width="44dp"
            android:layout_height="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDown"
            android:layout_width="78dp"
            android:layout_height="78dp"
            android:backgroundTint="@color/call_bg"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/arrow_down"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            app:cornerRadius="39dp" />
    </LinearLayout>

    <!-- 底部状态条 -->
    <TextView
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_bottom"
        android:gravity="center"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp"
        android:text="@string/not_connected"
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />

</LinearLayout>
